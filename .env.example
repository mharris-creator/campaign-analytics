# Copy to .env and fill in. Never commit .env.

# HubSpot private app token (starts with "pat-").
# Create one: Settings -> Integrations -> Private Apps -> Create a private app.
HUBSPOT_TOKEN=

# Where the local SQLite DB lives (defaults to data/campaign_analytics.db).
CAMPAIGN_DB_PATH=

# Optional: comma-separated HubSpot pipeline IDs/labels to treat as the
# opportunity (deal) pipeline(s). Leave blank to include all.
DEAL_PIPELINES=
